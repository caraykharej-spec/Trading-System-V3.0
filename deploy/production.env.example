TRADING_IMAGE_TAG=replace-with-immutable-release-id
TRADING_API_ENV=production
TRADING_API_REQUIRE_KEY=1
TRADING_API_KEY=replace-with-secret-manager-value
TRADING_API_ALLOWED_HOSTS=api.example.com
TRADING_API_DOCS_ENABLED=0
TRADING_API_DASHBOARD_ENABLED=1
TRADING_API_RUNTIME_CYCLE_ENABLED=0
TRADING_API_METRICS_ENABLED=1
TRADING_API_CORS_ORIGINS=
TRADING_TLS_TERMINATED=1
TRADING_API_LOG_LEVEL=info
